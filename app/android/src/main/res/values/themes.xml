<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Snapshot.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    </style>

    <style name="Theme.Snapshot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#373435</item>
        <!-- Reuse the adaptive launcher icon foreground so the compat splash (API <=30) shows the
             same mark the platform uses for the splash on API 31+ (the launcher icon). Single
             source of truth; already ships per-density buckets. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Snapshot.Base</item>
    </style>
</resources>