    <string name="profile_label_fire_rate_cap">Fire Rate Cap</string>
    <string name="profile_label_fire_rate_cap_details">Maximum fire rate in balls per second. The cocking solenoid closed dwell is increased if the fire rate is lower than the timing cycle allows. Set 0 for uncapped.</string>
    <string name="profile_label_eye_mode">Eye Mode</string>
    <string name="profile_label_eye_mode_details">Eye mode the marker supports if any</string>
    <!-- A fire mode or an eye mode that the board reports and this app does not know -->
    <string name="profile_mode_unknown">Unknown Mode</string>
    <string name="profile_mode_unknown_details">The board reports a mode that this app does not know. A save keeps the mode of the board until you select a mode.</string>
    <string name="profile_eye_mode_off">Off</string>
    <string name="profile_eye_mode_reflective">Reflective</string>
    <string name="profile_eye_mode_break_beam">Break Beam</string>
    <string name="profile_label_eye_threshold">Eye Threshold</string>
    <string name="profile_label_eye_threshold_details">Breach eye detection threshold as 0–100 percent of full scale; the eye sees a ball when the reading is below it. The app never sends 0 — the firmware would substitute its 50 percent default.</string>
    <string name="profile_label_eye_debounce">Eye Debounce</string>
    <string name="profile_label_eye_debounce_details">The time in milliseconds (0.1 ms steps) the eye must be within threshold to determine a ball is in the breach.</string>
    <string name="profile_label_sear_solenoid_dwell">Sear Solenoid Dwell</string>
    <string name="profile_label_sear_solenoid_dwell_details">The time in milliseconds (0.1 ms steps) the sear solenoid is energized during the firing cycle.</string>
    <string name="profile_label_cocking_solenoid_delay">Cocking Solenoid Delay</string>
    <string name="profile_label_cocking_solenoid_delay_details">The time in milliseconds (0.1 ms steps) the cocking solenoid waits after a trigger pull before energizing.</string>
    <string name="profile_label_cocking_solenoid_dwell_open">Cocking Solenoid Dwell Open</string>
    <string name="profile_label_cocking_solenoid_dwell_open_details">The time in milliseconds (0.1 ms steps) the cocking solenoid energizes to open the breach. When using an eye sensor, this setting is ignored.</string>
    <string name="profile_label_cocking_solenoid_dwell_closed">Cocking Solenoid Dwell Closed</string>
    <string name="profile_label_cocking_solenoid_dwell_closed_details">The time in milliseconds (0.1 ms steps) the cocking solenoid stays de-energized to close the breach and prevent the next firing cycle.</string>
    <string name="profile_label_cocking_solenoid_timeout">Cocking Solenoid Timeout</string>
    <string name="profile_label_cocking_solenoid_timeout_details">Anti-jam fail-open ceiling, in milliseconds (0.1 ms steps): the longest the cocking solenoid waits for the eye before closing on timing instead. Board default is 500 ms; it cannot be disabled (the app always sends a concrete value).</string>
    <string name="profile_label_ramping_custom_multiplier">Ramping Custom Multiplier</string>
    <string name="profile_label_ramping_custom_multiplier_details">The fire rate in ramping, as a multiple of the trigger-pull rate, after the ramping trigger-pull threshold is met. For example, 2.5× (250 percent) with 3 pulls in one second gives 7.5 balls per second.</string>
    <string name="profile_label_ramping_custom_trigger_pulls">Ramping Custom Trigger Pulls</string>
    <string name="profile_label_ramping_custom_trigger_pulls_details">The number of trigger pulls required in a one-second window to enter ramping for the following one second.</string>
    <string name="profile_label_ramping_custom_rof_minimum">Ramping Custom ROF Minimum</string>
    <string name="profile_label_ramping_custom_rof_minimum_details">A minimum rate of fire in ramping mode regardless of trigger pulls in the rolling window.</string>
    <string name="profile_label_trigger_debounce_on">Trigger Debounce On</string>
    <string name="profile_label_trigger_debounce_on_details">The time in milliseconds (0.1 ms steps) the trigger must be pulled to begin a firing cycle.</string>
    <string name="profile_label_trigger_debounce_off">Trigger Debounce Off</string>
    <string name="profile_label_trigger_debounce_off_details">The time in milliseconds (0.1 ms steps) the trigger must not be sensed before entering the trigger debounce-on cycle.</string>
