    <string name="profile_label_bolt_mode">Mode de culasse</string>
    <string name="profile_label_bolt_mode_details">Ordre de tir du marqueur&#160;: la culasse fermée déclenche d’abord le solénoïde de sear, tandis que la culasse ouverte déclenche d’abord le solénoïde d’armement.</string>
    <string name="profile_bolt_mode_closed">Culasse fermée</string>
    <string name="profile_bolt_mode_open">Culasse ouverte</string>
    <string name="profile_label_fire_rate_cap">Limite de cadence</string>
    <string name="profile_label_fire_rate_cap_details">Cadence de tir maximale en billes par seconde. Le temps de maintien fermé du solénoïde d’armement augmente si la cadence est inférieure à ce que permet le cycle de chronométrage. Mettez 0 pour ne pas limiter.</string>
    <string name="profile_label_eye_mode">Mode œil</string>
    <string name="profile_label_eye_mode_details">Mode œil pris en charge par le marqueur, le cas échéant</string>
    <!-- A fire mode or an eye mode that the board reports and this app does not know -->
    <string name="profile_mode_unknown">Mode inconnu</string>
    <string name="profile_mode_unknown_details">La carte signale un mode que cette app ne connaît pas. L’enregistrement conserve le mode de la carte jusqu’à ce que vous choisissiez un mode.</string>
    <string name="profile_eye_mode_off">Désactivé</string>
    <string name="profile_eye_mode_reflective">Réfléchissant</string>
    <string name="profile_eye_mode_break_beam">Barrière lumineuse</string>
    <string name="profile_label_eye_threshold">Seuil de l’œil</string>
    <string name="profile_label_eye_threshold_details">Seuil de détection de l’œil de chambre, de 0 à 100 pour cent de la pleine échelle; l’œil voit une bille lorsque la lecture est inférieure au seuil. L’application n’envoie jamais 0 — le firmware appliquerait sa valeur par défaut de 50 pour cent.</string>
    <string name="profile_label_eye_debounce">Anti-rebond de l’œil</string>
    <string name="profile_label_eye_debounce_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel l’œil doit rester sous le seuil pour confirmer qu’une bille est dans la chambre.</string>
    <string name="profile_label_sear_solenoid_dwell">Maintien du solénoïde de sear</string>
    <string name="profile_label_sear_solenoid_dwell_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel le solénoïde de sear est alimenté durant le cycle de tir.</string>
    <string name="profile_label_sear_solenoid_delay">Délai du solénoïde de sear</string>
    <string name="profile_label_sear_solenoid_delay_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel le solénoïde de sear attend après une pression sur la détente avant d’être alimenté en mode culasse ouverte.</string>
    <string name="profile_label_cocking_solenoid_delay">Délai du solénoïde d’armement</string>
    <string name="profile_label_cocking_solenoid_delay_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel le solénoïde d’armement attend après une pression sur la détente avant d’être alimenté.</string>
    <string name="profile_label_cocking_solenoid_dwell_open">Maintien ouvert du solénoïde d’armement</string>
    <string name="profile_label_cocking_solenoid_dwell_open_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel le solénoïde d’armement est alimenté pour ouvrir la chambre. Avec un capteur d’œil, ce réglage est ignoré.</string>
    <string name="profile_label_cocking_solenoid_dwell_closed">Maintien fermé du solénoïde d’armement</string>
    <string name="profile_label_cocking_solenoid_dwell_closed_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel le solénoïde d’armement reste non alimenté pour fermer la chambre et empêcher le cycle de tir suivant.</string>
    <string name="profile_label_cocking_solenoid_timeout">Délai maximal du solénoïde d’armement</string>
    <string name="profile_label_cocking_solenoid_timeout_details">Limite anti-blocage en ouverture, en millisecondes (pas de 0,1 ms)&#160;: durée maximale pendant laquelle le solénoïde d’armement attend l’œil avant de fermer selon le chronométrage. La valeur par défaut de la carte est 500 ms; elle ne peut pas être désactivée (l’application envoie toujours une valeur concrète).</string>
    <string name="profile_label_ramping_custom_multiplier">Multiplicateur de ramping personnalisé</string>
    <string name="profile_label_ramping_custom_multiplier_details">La cadence en ramping, en multiple du rythme des pressions sur la détente, une fois le seuil de pressions du ramping atteint. Par exemple, 2,5× (250 pour cent) avec 3 pressions en une seconde donne 7,5 billes par seconde.</string>
    <string name="profile_label_ramping_custom_trigger_pulls">Pressions sur la détente pour le ramping</string>
    <string name="profile_label_ramping_custom_trigger_pulls_details">Le nombre de pressions sur la détente requis dans une fenêtre d’une seconde pour passer en ramping pendant la seconde suivante.</string>
    <string name="profile_label_ramping_custom_rof_minimum">Cadence minimale en ramping</string>
    <string name="profile_label_ramping_custom_rof_minimum_details">Une cadence de tir minimale en mode ramping, quel que soit le nombre de pressions sur la détente dans la fenêtre glissante.</string>
    <string name="profile_label_trigger_debounce_on">Anti-rebond de détente à l’activation</string>
    <string name="profile_label_trigger_debounce_on_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel la détente doit être pressée pour lancer un cycle de tir.</string>
    <string name="profile_label_trigger_debounce_off">Anti-rebond de détente à la désactivation</string>
    <string name="profile_label_trigger_debounce_off_details">Le temps en millisecondes (pas de 0,1 ms) pendant lequel la détente ne doit pas être détectée avant d’entrer dans le cycle d’anti-rebond à l’activation.</string>
