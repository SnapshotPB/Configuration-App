    <string name="profile_label_fire_rate_cap">Límite de cadencia</string>
    <string name="profile_label_fire_rate_cap_details">Cadencia máxima de disparo en bolas por segundo. El dwell cerrado del solenoide de carga aumenta si la cadencia es menor de lo que permite el ciclo de tiempos. Pon 0 para no limitarla.</string>
    <string name="profile_label_eye_mode">Modo de ojos</string>
    <string name="profile_label_eye_mode_details">Modo de funcionamiento de los ojos del marcador</string>
    <!-- A fire mode or an eye mode that the board reports and this app does not know -->
    <string name="profile_mode_unknown">Modo desconocido</string>
    <string name="profile_mode_unknown_details">La placa indica un modo que esta app no conoce. Al guardar, la placa conserva su modo hasta que elijas un modo.</string>
    <string name="profile_eye_mode_off">Desactivado</string>
    <string name="profile_eye_mode_reflective">Reflectante</string>
    <string name="profile_eye_mode_break_beam">Barrera óptica</string>
    <string name="profile_label_eye_threshold">Umbral de los ojos</string>
    <string name="profile_label_eye_threshold_details">Umbral de detección de los ojos de la recámara, del 0 al 100 por ciento de la escala completa; los ojos ven una bola cuando la lectura está por debajo. La aplicación nunca envía 0 — el firmware aplicaría su valor predeterminado del 50 por ciento.</string>
    <string name="profile_label_eye_debounce">Antirrebote de ojos</string>
    <string name="profile_label_eye_debounce_details">El tiempo en milisegundos (pasos de 0,1 ms) que los ojos deben permanecer dentro del umbral para determinar que hay una bola en la recámara.</string>
    <string name="profile_label_sear_solenoid_dwell">Dwell del solenoide del fiador (Sear)</string>
    <string name="profile_label_sear_solenoid_dwell_details">El tiempo en milisegundos (pasos de 0,1 ms) que el solenoide del fiador permanece activado durante el ciclo de disparo.</string>
    <string name="profile_label_cocking_solenoid_delay">Retraso del solenoide de carga</string>
    <string name="profile_label_cocking_solenoid_delay_details">El tiempo en milisegundos (pasos de 0,1 ms) que el solenoide de carga espera tras una pulsación del gatillo antes de activarse.</string>
    <string name="profile_label_cocking_solenoid_dwell_open">Dwell de carga (Abierto)</string>
    <string name="profile_label_cocking_solenoid_dwell_open_details">El tiempo en milisegundos (pasos de 0,1 ms) que el solenoide de carga se activa para abrir la recámara. Si usas un sensor de ojos, este ajuste se ignora.</string>
    <string name="profile_label_cocking_solenoid_dwell_closed">Dwell de carga (Cerrado)</string>
    <string name="profile_label_cocking_solenoid_dwell_closed_details">El tiempo en milisegundos (pasos de 0,1 ms) que el solenoide de carga permanece desactivado para cerrar la recámara e impedir el siguiente ciclo de disparo.</string>
    <string name="profile_label_cocking_solenoid_timeout">Tiempo límite del solenoide de carga</string>
    <string name="profile_label_cocking_solenoid_timeout_details">Límite antiatasco de apertura segura, en milisegundos (pasos de 0,1 ms): el tiempo máximo que el solenoide de carga espera a los ojos antes de cerrar por tiempos. El valor predeterminado de la placa es 500 ms; no se puede desactivar (la aplicación siempre envía un valor concreto).</string>
    <string name="profile_label_ramping_custom_multiplier">Multiplicador de ramping</string>
    <string name="profile_label_ramping_custom_multiplier_details">La cadencia en ramping, como múltiplo del ritmo de pulsaciones, al alcanzar el umbral de pulsaciones del ramping. Por ejemplo, 2,5× (250 por ciento) con 3 pulsaciones en un segundo da 7,5 bolas por segundo.</string>
    <string name="profile_label_ramping_custom_trigger_pulls">Pulsaciones para ramping</string>
    <string name="profile_label_ramping_custom_trigger_pulls_details">Número de pulsaciones por segundo necesarias para activar el modo ramping.</string>
    <string name="profile_label_ramping_custom_rof_minimum">Cadencia mínima de ramping</string>
    <string name="profile_label_ramping_custom_rof_minimum_details">Cadencia de disparo mínima en modo ramping, independientemente de las pulsaciones.</string>
    <string name="profile_label_trigger_debounce_on">Antirrebote de gatillo (On)</string>
    <string name="profile_label_trigger_debounce_on_details">El tiempo en milisegundos (pasos de 0,1 ms) que el gatillo debe estar pulsado para iniciar un ciclo de disparo.</string>
    <string name="profile_label_trigger_debounce_off">Antirrebote de gatillo (Off)</string>
    <string name="profile_label_trigger_debounce_off_details">El tiempo en milisegundos (pasos de 0,1 ms) que el gatillo no debe detectarse antes de entrar en el ciclo de antirrebote activado.</string>
