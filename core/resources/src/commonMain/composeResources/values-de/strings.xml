    <string name="profile_label_fire_rate_cap">Feuerratenbegrenzung</string>
    <string name="profile_label_fire_rate_cap_details">Maximale Feuerrate in Bällen pro Sekunde. Die geschlossene Haltezeit des Cocking-Magnetventils wird erhöht, wenn die Feuerrate niedriger ist, als der Timing-Zyklus zulässt. 0 bedeutet keine Begrenzung.</string>
    <string name="profile_label_eye_mode">Augenmodus</string>
    <string name="profile_label_eye_mode_details">Augenmodus, den der Markierer unterstützt, falls vorhanden</string>
    <!-- A fire mode or an eye mode that the board reports and this app does not know -->
    <string name="profile_mode_unknown">Unbekannter Modus</string>
    <string name="profile_mode_unknown_details">Die Platine meldet einen Modus, den diese App nicht kennt. Beim Speichern behält die Platine ihren Modus, bis Sie einen Modus auswählen.</string>
    <string name="profile_eye_mode_off">Aus</string>
    <string name="profile_eye_mode_reflective">Reflektierend</string>
    <string name="profile_eye_mode_break_beam">Lichtschranke</string>
    <string name="profile_label_eye_threshold">Augenschwelle</string>
    <string name="profile_label_eye_threshold_details">Erkennungsschwelle der Augen im Breech als 0–100 Prozent des Vollausschlags; das Auge erkennt einen Ball, wenn der Messwert darunter liegt. Die App sendet nie 0 — die Firmware würde ihren Standardwert von 50 Prozent einsetzen.</string>
    <string name="profile_label_eye_debounce">Augen-Entprellung</string>
    <string name="profile_label_eye_debounce_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die das Auge innerhalb der Schwelle bleiben muss, damit ein Ball im Breech erkannt wird.</string>
    <string name="profile_label_sear_solenoid_dwell">Haltezeit Sear-Magnetventil</string>
    <string name="profile_label_sear_solenoid_dwell_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die das Sear-Magnetventil während des Schusszyklus bestromt wird.</string>
    <string name="profile_label_cocking_solenoid_delay">Verzögerung Cocking-Magnetventil</string>
    <string name="profile_label_cocking_solenoid_delay_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die das Cocking-Magnetventil nach einem Abzugszug wartet, bevor es bestromt wird.</string>
    <string name="profile_label_cocking_solenoid_dwell_open">Haltezeit Cocking-Magnetventil offen</string>
    <string name="profile_label_cocking_solenoid_dwell_open_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die das Cocking-Magnetventil bestromt wird, um den Breech zu öffnen. Bei Verwendung eines Augensensors wird diese Einstellung ignoriert.</string>
    <string name="profile_label_cocking_solenoid_dwell_closed">Haltezeit Cocking-Magnetventil geschlossen</string>
    <string name="profile_label_cocking_solenoid_dwell_closed_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die das Cocking-Magnetventil stromlos bleibt, um den Breech zu schließen und den nächsten Schusszyklus zu verhindern.</string>
    <string name="profile_label_cocking_solenoid_timeout">Zeitlimit Cocking-Magnetventil</string>
    <string name="profile_label_cocking_solenoid_timeout_details">Obergrenze gegen Verklemmen, in Millisekunden (Schritte von 0,1 ms): So lange wartet das Cocking-Magnetventil höchstens auf das Auge, bevor es stattdessen nach Timing schließt. Der Standardwert der Platine ist 500 ms; er lässt sich nicht abschalten (die App sendet immer einen konkreten Wert).</string>
    <string name="profile_label_ramping_custom_multiplier">Ramping-Multiplikator</string>
    <string name="profile_label_ramping_custom_multiplier_details">Die Feuerrate im Ramping als Vielfaches der Abzugsrate, sobald die Ramping-Schwelle der Abzugszüge erreicht ist. Beispiel: 2,5× (250 Prozent) bei 3 Abzugszügen in einer Sekunde ergibt 7,5 Bälle pro Sekunde.</string>
    <string name="profile_label_ramping_custom_trigger_pulls">Ramping-Abzugszüge</string>
    <string name="profile_label_ramping_custom_trigger_pulls_details">Die Anzahl der Abzugszüge innerhalb einer Sekunde, die nötig ist, um für die folgende Sekunde in das Ramping zu wechseln.</string>
    <string name="profile_label_ramping_custom_rof_minimum">Ramping-Mindestfeuerrate</string>
    <string name="profile_label_ramping_custom_rof_minimum_details">Eine Mindestfeuerrate im Ramping-Modus, unabhängig von den Abzugszügen im gleitenden Zeitfenster.</string>
    <string name="profile_label_trigger_debounce_on">Abzug-Entprellung ein</string>
    <string name="profile_label_trigger_debounce_on_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die der Abzug gezogen sein muss, damit ein Schusszyklus beginnt.</string>
    <string name="profile_label_trigger_debounce_off">Abzug-Entprellung aus</string>
    <string name="profile_label_trigger_debounce_off_details">Die Zeit in Millisekunden (Schritte von 0,1 ms), die der Abzug nicht erkannt werden darf, bevor der Zyklus „Abzug-Entprellung ein“ beginnt.</string>
