    <!-- Web/browser unsupported-Bluetooth block screen (Chromium-only Web Bluetooth) -->
    <string name="unsupported_browser_title">Bluetooth ist in diesem Browser nicht verfügbar</string>
    <string name="unsupported_browser_message">Snapshot PB verbindet sich über Bluetooth mit Ihrer Platine. Im Web geht das nur in einem Chromium-Browser — Chrome, Edge oder Opera. Öffnen Sie diese Seite in einem davon, um Ihre Platine zu suchen und zu konfigurieren.</string>
    <string name="unsupported_browser_details_show">Warum nicht in diesem Browser?</string>
    <string name="unsupported_browser_details_hide">Details ausblenden</string>
    <string name="unsupported_browser_details_webkit">Web Bluetooth — die Browser-Schnittstelle, die diese App verwendet — gibt es nur in Chromium-Browsern. Safari und alle Browser auf iPhone und iPad bauen auf WebKit von Apple auf, das sie nie umgesetzt hat; dort funktioniert Bluetooth also nicht. Verwenden Sie auf Apple-Geräten stattdessen die native Snapshot PB-App.</string>
    <string name="unsupported_browser_details_firefox">Auch Firefox hat kein Web Bluetooth, jedoch aus einem anderen Grund: Mozilla hat die Umsetzung aus Datenschutzgründen abgelehnt.</string>
