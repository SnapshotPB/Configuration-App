    <!-- Web/browser unsupported-Bluetooth block screen (Chromium-only Web Bluetooth) -->
    <string name="unsupported_browser_title">Le Bluetooth n’est pas disponible dans ce navigateur</string>
    <string name="unsupported_browser_message">Snapshot PB communique avec votre carte en Bluetooth, ce que l’application web ne peut faire que dans un navigateur basé sur Chromium — Chrome, Edge ou Opera. Ouvrez cette page dans l’un d’eux pour rechercher et configurer votre carte.</string>
    <string name="unsupported_browser_details_show">Pourquoi pas ce navigateur?</string>
    <string name="unsupported_browser_details_hide">Masquer les détails</string>
    <string name="unsupported_browser_details_webkit">Web Bluetooth — l’interface de navigateur qu’utilise cette application — n’existe que dans les navigateurs Chromium. Safari et tous les navigateurs sur iPhone et iPad reposent sur WebKit d’Apple, qui ne l’a jamais implémentée; le Bluetooth n’y fonctionnera donc pas. Sur les appareils Apple, utilisez plutôt l’application native Snapshot PB.</string>
